# Copie para .env e ajuste. Nada aqui é lido por padrão sem a variável existir.
# O .env NÃO deve ser versionado (veja .gitignore).

# Ambiente: development | testing | production
SKYSYNC_ENV=development

# Host/porta do servidor
SKYSYNC_HOST=127.0.0.1
SKYSYNC_PORT=5000

# Chave de assinatura de sessão — gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SKYSYNC_SECRET_KEY=troque-esta-chave

# Caminho do banco SQLite
SKYSYNC_DB_PATH=./skysync.db

# Origens liberadas no CORS, separadas por vírgula
SKYSYNC_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Otimizador: teto de tempo (s) e limite padrão de jornada (h)
SKYSYNC_SOLVER_MAX_TIME=10
SKYSYNC_HOUR_LIMIT=11.0

# Tamanho máximo do payload de histórico (bytes)
SKYSYNC_MAX_PAYLOAD=2097152
