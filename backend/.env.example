# Copie para .env e ajuste. O .env NÃO deve ser versionado.

# Ambiente: development | testing | production
SKYSYNC_ENV=development

# Host/porta do servidor
SKYSYNC_HOST=127.0.0.1
SKYSYNC_PORT=5000

# ---------------------------------------------------------------------------
# BANCO DE DADOS — o item mais importante deste arquivo
# ---------------------------------------------------------------------------
# Cole aqui a connection string do seu banco PostgreSQL na nuvem.
# Onde pegar:
#   Neon     → https://neon.tech      (Dashboard → Connect)
#   Supabase → https://supabase.com   (Settings → Database)
#   Railway  → https://railway.app    (Postgres → Connect)
#
# Aceita os dois formatos: postgres:// e postgresql://
# O código acrescenta sslmode=require automaticamente para host remoto.
DATABASE_URL=postgresql://SkySync_owner:npg_6bcOGo8ejtFY@ep-broad-sunset-b6cepg2t-pooler.c-2.sa-east-1.aws.neon.tech/SkySync?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------------
# SESSÃO
# ---------------------------------------------------------------------------
# Gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SKYSYNC_SECRET_KEY=troque-esta-chave

# ---------------------------------------------------------------------------
# CORS — origens liberadas, separadas por vírgula
# Use a origem exata do front. Com cookie de sessão, curinga não funciona.
# ---------------------------------------------------------------------------
SKYSYNC_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# OTIMIZADOR
# ---------------------------------------------------------------------------
SKYSYNC_SOLVER_MAX_TIME=10
SKYSYNC_HOUR_LIMIT=11.0
SKYSYNC_MAX_PAYLOAD=2097152

# ---------------------------------------------------------------------------
# PRODUÇÃO (quando servir por HTTPS)
# ---------------------------------------------------------------------------
# SKYSYNC_COOKIE_SECURE=1
